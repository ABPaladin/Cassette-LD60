"end": 18.0,
"start": 0.5,
"text": "I couldn't say this in person. Keep my things. Remember me before all this. Goodbye."
}, {
"end": 43.0,
"start": 36.0,
"text": "I tried to tell someone. He was always listening."
}, {
"end": 72.0,
"start": 65.0,
"text": "If they call this a farewell, listen again. I wanted to come home."
}, {
"end": 142.0,
"start": 130.0,
"text": "I left the times in my notebook. The little pet remembers the order."
}])
