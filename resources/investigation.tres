captions = Array[Dictionary]([{
"end": 7,
"speaker": "Emily",
"start": 0,
"text": "Hey. It's me. I'm at our little caf? across from the gallery."
}, {
"end": 12,
"speaker": "Emily",
"start": 7,
"text": "They've changed the curtains, but the coffee's still terrible."
}, {
"end": 18,
"speaker": "Emily",
"start": 12,
"text": "I almost called. Then I remembered how we used to save everything on tape."
}, {
"end": 23,
"speaker": "Emily",
"start": 18,
"text": "I even found that pencil you used to rewind cassettes with."
}, {
"end": 28,
"speaker": "Radio DJ",
"start": 24,
"text": "Check your watches, night owls. You're listening to Midnight FM."
}, {
"end": 32,
"speaker": "Radio DJ",
"start": 28,
"text": "Here's something to keep you company until closing."
}, {
"end": 38,
"speaker": "Emily",
"start": 32,
"text": "They still play songs like that. Remember our game?"
}, {
"end": 46,
"speaker": "Emily",
"start": 38,
"text": "We'd pick tiny pieces out of a whole song and make a sentence no one else could hear."
}, {
"end": 50,
"speaker": "Emily",
"start": 46,
"text": "You always won. I hated that."
}, {
"end": 57,
"speaker": "Emily",
"start": 51,
"text": "Don't laugh, but I've been playing it again. Four little pieces this time."
}, {
"end": 64,
"speaker": "Emily",
"start": 57,
"text": "Nothing clever, really. You might even recognize some of the words."
}, {
"end": 71,
"speaker": "Emily",
"start": 64,
"text": "I brought my sketchbook today. There's a drawing of a room I couldn't get quite right."
}, {
"end": 78,
"speaker": "Emily",
"start": 71,
"text": "I keep remembering one little detail differently."
}, {
"end": 86,
"speaker": "Emily",
"start": 79,
"text": "The door is wrong in the drawing. Or maybe it's the only thing I got right."
}, {
"end": 92,
"speaker": "Emily",
"start": 86,
"text": "See the tiny marks beside it? Same game as before."
}, {
"end": 97,
"speaker": "Emily",
"start": 92,
"text": "I couldn't decide where each bit belonged."
}, {
"end": 103,
"speaker": "Emily",
"start": 97,
"text": "You always understood my messy pages better than I did."
}, {
"end": 111,
"speaker": "Emily",
"start": 104,
"text": "Trust him with the order, you'd say, pointing at that ridiculous little digital pet."
}, {
"end": 117,
"speaker": "Emily",
"start": 111,
"text": "Imagine trusting a toy with something important. Well... maybe you were right."
}, {
"end": 124,
"speaker": "Emily",
"start": 117,
"text": "I put him beside the sketchbook in a box with your name on it."
}, {
"end": 131,
"speaker": "Emily",
"start": 124,
"text": "Keep them together, okay? Please don't throw either of them away."
}, {
"end": 139,
"speaker": "Emily",
"start": 131,
"text": "Sometimes people can tell a story so neatly that you stop asking questions."
}, {
"end": 146,
"speaker": "Emily",
"start": 139,
"text": "There can be something missing, and nobody notices because the ending sounds right."
}, {
"end": 155,
"speaker": "Emily",
"start": 146,
"text": "So if you hear something about me one day that feels wrong, don't try to make sense of the ending first."
}, {
"end": 159,
"speaker": "Emily",
"start": 155,
"text": "Start with the little pieces."
}, {
"end": 164,
"speaker": "Emily",
"start": 159,
"text": "And don't go looking for answers by yourself."
}, {
"end": 170,
"speaker": "Emily",
"start": 164,
"text": "If you find anything that scares you, talk to someone you can trust. Promise?"
}, {
"end": 177,
"speaker": "Emily",
"start": 170,
"text": "I love you. See you when the song is over."
}, {
"end": 178.5,
"speaker": "Waiter",
"start": 177,
"text": "Anything else?"
}, {
"end": 179.5,
"speaker": "Emily",
"start": 178.5,
"text": "No, thank you."
}, {
"end": 180,
"speaker": "",
"start": 179.5,
"text": "[SFX: Cassette stops.]"
}])
