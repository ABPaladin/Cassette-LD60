captions = Array[Dictionary]([{"start":0.5, "end":18.0, "text":"I couldn't say this in person. Keep my things. Remember me before all this. Goodbye."}, {"start":36.0, "end":43.0, "text":"I tried to tell someone. He was always listening."}, {"start":65.0, "end":72.0, "text":"If they call this a farewell, listen again. I wanted to come home."}, {"start":130.0, "end":142.0, "text":"I left the times in my notebook. The little pet remembers the order."}])
