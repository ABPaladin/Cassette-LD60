fragments = Array[Dictionary]([{"id":"1", "clip":"res://assets/audio/placeholder/fragment_1.wav", "time":24.0, "duration":3.0, "message":"CHECK"}, {"id":"2", "clip":"res://assets/audio/placeholder/fragment_2.wav", "time":51.0, "duration":3.0, "message":"DON'T"}, {"id":"3", "clip":"res://assets/audio/placeholder/fragment_3.wav", "time":79.0, "duration":3.0, "message":"THE DOOR"}, {"id":"4", "clip":"res://assets/audio/placeholder/fragment_4.wav", "time":104.0, "duration":3.0, "message":"TRUST HIM"}])
